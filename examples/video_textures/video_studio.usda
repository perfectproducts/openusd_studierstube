26), (0, 0.258819, 0.965926), (0, 0.227076, 0.973877), (0, 0.227076, 0.973877), (0, 0.19509, 0.980785), (0, 0.19509, 0.980785), (0, 0.162895, 0.986643), (0, 0.162895, 0.986643), (0, 0.130526, 0.991445), (0, 0.130526, 0.991445), (0, 0.0980171, 0.995185), (0, 0.0980171, 0.995185), (0, 0.0654031, 0.997859), (0, 0.0654031, 0.997859), (0, 0.0327191, 0.999465), (0, 0.0327191, 0.999465), (0, 6.12323e-17, 1), (0, 6.12323e-17, 1), (0, 6.12323e-17, 1), (0, 6.12323e-17, 1)] (
                interpolation = "vertex"
            )
            uniform token subdivisionScheme = "none"
            bool doubleSided = 1
            rel material:binding = </World/Studio/BackdropMaterial>
        }

        def Material "BackdropMaterial"
        {
            token outputs:mdl:surface.connect = </World/Studio/BackdropMaterial/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.035, 0.04, 0.055)
                float inputs:reflection_roughness_constant = 0.42
                float inputs:specular_level = 0.45
                token outputs:out
            }
        }

        # Frames the sphere and the screen; the auto camera would frame the
        # whole backdrop.
        def Camera "Camera"
        {
            float2 clippingRange = (1, 100000)
            float focalLength = 35
            float horizontalAperture = 36
            float verticalAperture = 20.25
            double3 xformOp:translate = (-15, 95, 365)
            float3 xformOp:rotateXYZ = (-7, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }

        # Large soft key from the upper front left
        def RectLight "KeyLight"
        {
            float inputs:width = 300
            float inputs:height = 300
            float inputs:intensity = 9000
            color3f inputs:color = (1, 0.96, 0.9)
            double3 xformOp:translate = (-450, 450, 450)
            float3 xformOp:rotateXYZ = (-35, -45, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }

        # Cool rim from behind the subjects, lifting them off the backdrop
        def RectLight "RimLight"
        {
            float inputs:width = 400
            float inputs:height = 120
            float inputs:intensity = 6000
            color3f inputs:color = (0.75, 0.85, 1)
            double3 xformOp:translate = (0, 300, -180)
            float3 xformOp:rotateXYZ = (-120, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
    }

    def Scope "Looks"
    {
        def Material "VideoMaterial"
        {
            token outputs:mdl:surface.connect = </World/Looks/VideoMaterial/Shader.outputs:out>
            token outputs:mdl:displacement.connect = </World/Looks/VideoMaterial/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/VideoMaterial/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                # Kit 110.4: video file referenced like any image texture
                asset inputs:diffuse_texture = @./textures/test_video.mp4@ (
                    colorSpace = "auto"
                )
                # Emissive so the screen reads like a display even in a dark scene
                bool inputs:enable_emission = 1
                asset inputs:emissive_color_texture = @./textures/test_video.mp4@ (
                    colorSpace = "auto"
                )
                float inputs:emissive_intensity = 1000
                token outputs:out
            }
        }
    }
}
