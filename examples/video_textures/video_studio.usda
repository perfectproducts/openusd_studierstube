#usda 1.0
(
    doc = '''Video-texture demo scene for ovrtx and Kit 110.4.

    A UV sphere and a 16:9 screen, both showing textures/test_video.mp4
    (10 s, 1280 x 720, 30 fps, with a running timecode in its corner) through
    an OmniPBR diffuse and emissive texture, in a photo-studio set: a dark,
    slightly glossy cyclorama with a key and a rim light.

        /World/Studio/Camera  perspective, framing the sphere and the screen.
                              Use it rather than the auto camera, which would
                              frame the whole backdrop.

    The timeline matches the video (time code = video seconds x 24), so a
    gif/mp4 render with no range covers the whole clip.

    Video textures need the GStreamer plugin folder in the installed ovrtx
    package (ovrtx/bin/plugins/gpu.foundation/gstreamer-1.0); the wheel does
    not ship it, and without it the first render step hangs.'''
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 240
    timeCodesPerSecond = 24
    framesPerSecond = 30
)

def Xform "World"
{
    def Xform "Xform"
    {
    }

    # UV sphere mesh (implicit Sphere prims have no primvars:st, so textures can't map onto them)
    def Mesh "Sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
