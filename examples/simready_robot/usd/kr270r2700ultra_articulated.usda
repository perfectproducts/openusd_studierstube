#usda 1.0
(
    defaultPrim = "kr270r2700ultra"
    metersPerUnit = 0.001
    subLayers = [
        @./kr270r2700ultra_material_physics.usd@
    ]
    upAxis = "Z"
)

over "kr270r2700ultra" (
    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    over "kr270r2700ultra"
    {
        over "k1" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 232.67336
        }

        over "k2" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 266.30396
        }

        over "k3" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 105.51266
