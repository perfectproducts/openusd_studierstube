        over "k10" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
        )
        {
            rel physics:filteredPairs = </kr270r2700ultra/kr270r2700ultra/k2>
            float physics:mass = 0.46858442
        }
    }

