#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = """Live scene for viewer_app.py: the mappings of bouncing_ball.usda and rotator.usda plus floor, lights, camera and render product.

    BouncingBall FMU (FMI 2.0) mapped onto an OpenUSD ball with ovfmi.

    FMU variable          direction          OpenUSD attribute on /World/Ball
    -------------------   ----------------   ---------------------------------
    h   (output, m)       FMU -> USD         xformOp:translate   (y component)
    v   (output, m/s)     FMU -> USD         sim:velocity
    e   (parameter, 0.5..1, tunable)
                          USD -> FMU         sim:restitution

    Not mapped: g (fixed parameter, -9.81), v_min (constant), time, der(h), der(v)."""
)

def Xform "World"
{
    def Sphere "Ball"
    {
        double radius = 0.1
        rel material:binding = </Looks/BallMaterial>

        # Driven by the FMU: output h overwrites the y component each step.
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        # Driven by the FMU: output v, free for UI, audio, motion blur, ...
        double sim:velocity = 0

        # Read by the FMU: input e. Edit this value on the stage to change the bounce.
        double sim:restitution = 0.7
    }

    # Driven by the Rotator FMU (see rotator.usda): angle -> xformOp:rotateXYZ (y component), inputs from sim:*.
    def Cube "Rotor"
    {
        double size = 1
        double3 xformOp:translate = (-0.9, 0, 0)
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (1.0, 0.2, 0.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        rel material:binding = </Looks/RotorMaterial>

        double sim:omega = 90
        double sim:speed = 90
        double sim:acceleration = 0
        bool sim:enabled = 1
    }
}

# The FMU instance lives next to the scene it drives, not inside it.
def FmuInstance "BouncingBallFmu"
{
    bool fmi:enabled = 1
    asset fmi:fmu = @./fmus/BouncingBall.fmu@

    # One connection per set of target prims. Every mapping below is applied to each target.
    def FmuConnection "BallConnection"
    {
        rel fmi:targets = </World/Ball>

        # fmi:direction = "output": FMU -> USD.
        # fmi:usdMapping = (first, last) component range written into the attribute value.
        # (1, 1) on a double3 writes only y; x and z keep their authored values.
        def FmuMapping "HeightToY"
        {
            token fmi:direction = "output"
            token fmi:fmuAttribute = "h"
            int2 fmi:usdMapping = (1, 1)
            token fmi:usdAttribute = "xformOp:translate"
        }

        # Scalar attribute: (0, 1) covers its single component.
        def FmuMapping "VelocityOut"
        {
            token fmi:direction = "output"
            token fmi:fmuAttribute = "v"
            int2 fmi:usdMapping = (0, 1)
            token fmi:usdAttribute = "sim:velocity"
        }

        # fmi:direction = "input": USD -> FMU.
        def FmuMapping "RestitutionIn"
        {
            token fmi:direction = "input"
            token fmi:fmuAttribute = "e"
            int2 fmi:usdMapping = (0, 1)
            token fmi:usdAttribute = "sim:restitution"
        }
    }
}

def FmuInstance "RotatorFmu"
{
    bool fmi:enabled = 1
    asset fmi:fmu = @./fmus/Rotator.fmu@

    def FmuConnection "RotorConnection"
    {
        rel fmi:targets = </World/Rotor>

        def FmuMapping "AngleToRotateXYZ"
        {
            token fmi:direction = "output"
            token fmi:fmuAttribute = "angle"
            int2 fmi:usdMapping = (1, 1)
            token fmi:usdAttribute = "xformOp:rotateXYZ"
        }

        def FmuMapping "OmegaOut"
        {
            token fmi:direction = "output"
            token fmi:fmuAttribute = "omega"
            int2 fmi:usdMapping = (0, 1)
            token fmi:usdAttribute = "sim:omega"
        }

        def FmuMapping "SpeedIn"
        {
            token fmi:direction = "input"
            token fmi:fmuAttribute = "speed"
            int2 fmi:usdMapping = (0, 1)
            token fmi:usdAttribute = "sim:speed"
        }

        def FmuMapping "AccelerationIn"
        {
            token fmi:direction = "input"
            token fmi:fmuAttribute = "acceleration"
            int2 fmi:usdMapping = (0, 1)
            token fmi:usdAttribute = "sim:acceleration"
        }

        def FmuMapping "EnabledIn"
        {
            token fmi:direction = "input"
            token fmi:fmuAttribute = "enabled"
            int2 fmi:usdMapping = (0, 1)
            token fmi:usdAttribute = "sim:enabled"
        }
    }
}

def Scope "Looks"
{
    def Material "RotorMaterial"
    {
        token outputs:surface.connect = </Looks/RotorMaterial/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.15, 0.45, 0.85)
            float inputs:roughness = 0.35
            token outputs:surface
        }
    }

    def Material "BallMaterial"
    {
        token outputs:surface.connect = </Looks/BallMaterial/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.92, 0.28, 0.12)
            float inputs:roughness = 0.25
            token outputs:surface
        }
    }

    def Material "FloorMaterial"
    {
        token outputs:surface.connect = </Looks/FloorMaterial/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.55, 0.58, 0.63)
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
}

# The floor top sits at y = -0.1: the ball (radius 0.1) touches it when the FMU height h is 0.
def Cube "Floor"
{
    double size = 1
    double3 xformOp:translate = (0, -0.6, 0)
    float3 xformOp:scale = (6, 1, 6)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    rel material:binding = </Looks/FloorMaterial>
}

def DomeLight "Sky"
{
    float inputs:intensity = 150
    color3f inputs:color = (0.75, 0.85, 1.0)
}

def DistantLight "Sun"
{
    float inputs:intensity = 2200
    float inputs:angle = 1.5
    color3f inputs:color = (1.0, 0.95, 0.85)
    float3 xformOp:rotateXYZ = (-50, -35, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

# The viewer app overwrites this camera's omni:xform for the mouse orbit.
def Camera "Camera"
{
    float focalLength = 24
    double3 xformOp:translate = (0.9, 0.5, 2.6)
    float3 xformOp:rotateXYZ = (-3, 18, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}

# ovrtx renders this product; resolution is set by the viewer app.
def Scope "RenderSvc"
{
    def RenderProduct "Product"
    {
        rel camera = </Camera>
        int2 resolution = (960, 540)
        rel orderedVars = <LdrColor>
        def RenderVar "LdrColor"
        {
            string sourceName = "LdrColor"
        }
    }
}
